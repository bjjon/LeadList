# Copy to .env and fill in real values before running ./deploy.sh
DB_USER=
DB_PASSWORD=
DB_NAME=leadlist
JWT_SECRET=
JWT_EXPIRATION=28800000

# Only needed when running the backend individually (IDE / ./mvnw spring-boot:run),
# e.g. from an EnvFile-style IDE run configuration that loads this file.
# Not used by Docker Compose: there DB_HOST/DB_PORT are hardcoded to postgres/5432
# in docker-compose.yaml. For a local run against the Dockerized Postgres
# (published via docker-compose.override.yml), use:
DB_HOST=localhost
DB_PORT=5432
